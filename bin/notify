#!/usr/bin/env bash
# notify [--channel <channel_id>] [--md] [--dry-run] [message...]
#
# Push a message to Discord, independent of the relay process. Reads the bot
# token (and the owner's DM channel) from the relay's settings DB
# (data/app.db), same as safe-update-relay — so it works even while the relay
# is down or mid-restart.
#
# Default target is the OWNER'S DM. Scheduled jobs must NOT call this — their
# stdout is delivered by the scheduler to the job's own channel; notify is for
# ad-hoc proactive messages ("tell me later" timers, deploy pings).
#
# Message comes from the args, or from stdin when no message args are given
# (e.g. `claude -p "..." | bin/notify`). Discord renders Markdown natively;
# long messages are sent in 1900-char chunks. @everyone/@here and role pings
# are always neutralized.
#
# Options:
#   --channel <id>  target channel or thread id (default: the owner's DM)
#   --md            accepted for compatibility — Discord messages are already
#                   Markdown, so this is a no-op
#   --dry-run       print the request bodies instead of sending
#
# Delivery path: sends are routed through the relay's POST /api/notify when
# the relay is up — that logs the message to the dashboard feed and queues it
# as context for the agent's next turn in the target conversation. When the
# relay is down, falls back to the direct Discord API and (for owner-DM
# sends) best-effort records the same bookkeeping straight into the DB.
#
# Env: RELAY_DB overrides the settings DB path; RELAY_URL overrides the relay
# base URL (default: tries http://127.0.0.1:$PORT, then :8100, then :8101);
# NOTIFY_TOKEN is forwarded as X-Notify-Token if the relay requires one.

set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DB="${RELAY_DB:-$REPO_DIR/data/app.db}"
API="https://discord.com/api/v10"

CHANNEL_ID=""
EXPLICIT_CHANNEL=0
DRY_RUN=0
MSG_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --channel) CHANNEL_ID="${2:?--channel needs a value}"; EXPLICIT_CHANNEL=1; shift 2 ;;
    --md)      shift ;; # no-op: Discord is Markdown-native
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         MSG_ARGS+=("$1"); shift ;;
  esac
done

if [ ${#MSG_ARGS[@]} -gt 0 ]; then
  MSG="${MSG_ARGS[*]}"
else
  MSG="$(cat)"
fi
# Empty message → silent no-op, so piped callers that output nothing on quiet
# runs don't error. (Glob match, not ${MSG//…/} substitution: the latter is
# quadratic in bash and hangs for minutes on large piped input.)
if [[ "$MSG" != *[![:space:]]* ]]; then
  exit 0
fi

# Try the relay's /api/notify first; 0 = accepted (message delivered + logged
# + queued as agent context — nothing left to do).
relay_send() {
  [ "$DRY_RUN" = 0 ] || return 1
  local body base code
  body="$(jq -n --arg t "$MSG" --arg c "$CHANNEL_ID" \
    '{text: $t, format: "md", source: "notify"}
     + (if $c != "" then {channel_id: $c} else {} end)')"
  for base in ${RELAY_URL:-} ${PORT:+http://127.0.0.1:$PORT} \
              http://127.0.0.1:8100 http://127.0.0.1:8101; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 -X POST "$base/api/notify" \
      -H 'Content-Type: application/json' \
      ${NOTIFY_TOKEN:+-H "X-Notify-Token: $NOTIFY_TOKEN"} \
      -d "$body" 2>/dev/null)"
    [ "$code" = "200" ] && return 0
  done
  return 1
}

if relay_send; then
  exit 0
fi

TOKEN="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='discord_bot_token'" 2>/dev/null || true)"
if [ -z "$TOKEN" ]; then
  echo "notify: no discord_bot_token in $DB" >&2
  exit 1
fi

# Resolve the default target: the owner's DM channel (cached in settings; open
# it via the API if missing and cache it back).
if [ -z "$CHANNEL_ID" ]; then
  CHANNEL_ID="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='discord_dm_channel_id'" 2>/dev/null || true)"
fi
if [ -z "$CHANNEL_ID" ]; then
  OWNER_ID="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='discord_owner_id'" 2>/dev/null || true)"
  if [ -z "$OWNER_ID" ]; then
    echo "notify: no target — finish onboarding (owner link) or pass --channel" >&2
    exit 1
  fi
  RESP="$(curl -s --max-time 15 -X POST "$API/users/@me/channels" \
    -H "Authorization: Bot $TOKEN" -H 'Content-Type: application/json' \
    -d "$(jq -n --arg id "$OWNER_ID" '{recipient_id: $id}')")"
  CHANNEL_ID="$(echo "$RESP" | jq -r '.id // empty')"
  if [ -z "$CHANNEL_ID" ]; then
    echo "notify: couldn't open the owner's DM: $RESP" >&2
    exit 1
  fi
  sqlite3 "$DB" "INSERT INTO settings (key, value) VALUES ('discord_dm_channel_id', '$CHANNEL_ID')
                 ON CONFLICT(key) DO UPDATE SET value=excluded.value" 2>/dev/null || true
fi

# Direct-path bookkeeping: the relay wasn't involved, so record the message in
# its DB ourselves — a dashboard-feed row plus context for the agent's next
# turn in the owner's DM conversation. Only for default (owner-DM) sends —
# for --channel targets we can't tell channel vs thread without the API.
# Best-effort: never fails the send.
record_direct() {
  [ "$EXPLICIT_CHANNEL" = 0 ] || return 0
  [ "$DRY_RUN" = 0 ] || return 0
  local now esc
  now="$(($(date +%s) * 1000))"
  esc="${ORIG_MSG//\'/\'\'}"
  sqlite3 "$DB" "
    CREATE TABLE IF NOT EXISTS pending_context (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      created_at INTEGER NOT NULL,
      source TEXT NOT NULL,
      kind TEXT,
      text TEXT NOT NULL,
      session_key TEXT NOT NULL
    );
    INSERT INTO message_log (created_at, direction, text, session_id, ok, error)
      VALUES ($now, 'out', '[notify] ' || '$esc', NULL, 1, NULL);
    INSERT INTO pending_context (created_at, source, text, session_key)
      VALUES ($now, 'notify', substr('$esc', 1, 1500), 'claude_session_id:dm:' || '$CHANNEL_ID');
  " 2>/dev/null || true
}

# Discord caps message content at 2000 chars; chunk conservatively. The loop
# consumes $MSG chunk by chunk; keep the original for bookkeeping.
MAX_CHUNK=1900
ORIG_MSG="$MSG"

while [ -n "$MSG" ]; do
  CHUNK="${MSG:0:$MAX_CHUNK}"
  MSG="${MSG:$MAX_CHUNK}"
  BODY="$(jq -n --arg t "$CHUNK" '{content: $t, allowed_mentions: {parse: ["users"]}}')"
  if [ "$DRY_RUN" = "1" ]; then
    echo "$BODY"
    continue
  fi
  RESP="$(curl -s --max-time 15 -X POST "$API/channels/$CHANNEL_ID/messages" \
    -H "Authorization: Bot $TOKEN" -H 'Content-Type: application/json' -d "$BODY")"
  if ! echo "$RESP" | jq -e '.id' >/dev/null 2>&1; then
    echo "notify: send failed: $RESP" >&2
    exit 1
  fi
done

record_direct
