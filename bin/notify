#!/usr/bin/env bash
# notify [--channel <channel_id>] [--md] [--dry-run] [message...]
#
# Push a message to Discord, independent of the relay process. Reads the bot
# token (and the owner's DM channel) from the relay's settings DB
# (data/app.db), same as safe-update-relay — so it works even while the relay
# is down or mid-restart.
#
# Default target is the OWNER'S DM. Scheduled jobs must NOT call this — their
# stdout is delivered by the scheduler to the job's own channel; notify is for
# ad-hoc proactive messages ("tell me later" timers, deploy pings).
#
# Message comes from the args, or from stdin when no message args are given
# (e.g. `claude -p "..." | bin/notify`). Discord renders Markdown natively;
# long messages are sent in 1900-char chunks. @everyone/@here and role pings
# are always neutralized.
#
# Options:
#   --channel <id>  target channel or thread id (default: the owner's DM)
#   --md            accepted for compatibility — Discord messages are already
#                   Markdown, so this is a no-op
#   --dry-run       print the request bodies instead of sending
#
# Env: RELAY_DB overrides the settings DB path.

set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DB="${RELAY_DB:-$REPO_DIR/data/app.db}"
API="https://discord.com/api/v10"

CHANNEL_ID=""
DRY_RUN=0
MSG_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --channel) CHANNEL_ID="${2:?--channel needs a value}"; shift 2 ;;
    --md)      shift ;; # no-op: Discord is Markdown-native
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         MSG_ARGS+=("$1"); shift ;;
  esac
done

if [ ${#MSG_ARGS[@]} -gt 0 ]; then
  MSG="${MSG_ARGS[*]}"
else
  MSG="$(cat)"
fi
# Empty message → silent no-op, so piped callers that output nothing on quiet
# runs don't error. (Glob match, not ${MSG//…/} substitution: the latter is
# quadratic in bash and hangs for minutes on large piped input.)
if [[ "$MSG" != *[![:space:]]* ]]; then
  exit 0
fi

TOKEN="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='discord_bot_token'" 2>/dev/null || true)"
if [ -z "$TOKEN" ]; then
  echo "notify: no discord_bot_token in $DB" >&2
  exit 1
fi

# Resolve the default target: the owner's DM channel (cached in settings; open
# it via the API if missing and cache it back).
if [ -z "$CHANNEL_ID" ]; then
  CHANNEL_ID="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='discord_dm_channel_id'" 2>/dev/null || true)"
fi
if [ -z "$CHANNEL_ID" ]; then
  OWNER_ID="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='discord_owner_id'" 2>/dev/null || true)"
  if [ -z "$OWNER_ID" ]; then
    echo "notify: no target — finish onboarding (owner link) or pass --channel" >&2
    exit 1
  fi
  RESP="$(curl -s --max-time 15 -X POST "$API/users/@me/channels" \
    -H "Authorization: Bot $TOKEN" -H 'Content-Type: application/json' \
    -d "$(jq -n --arg id "$OWNER_ID" '{recipient_id: $id}')")"
  CHANNEL_ID="$(echo "$RESP" | jq -r '.id // empty')"
  if [ -z "$CHANNEL_ID" ]; then
    echo "notify: couldn't open the owner's DM: $RESP" >&2
    exit 1
  fi
  sqlite3 "$DB" "INSERT INTO settings (key, value) VALUES ('discord_dm_channel_id', '$CHANNEL_ID')
                 ON CONFLICT(key) DO UPDATE SET value=excluded.value" 2>/dev/null || true
fi

# Discord caps message content at 2000 chars; chunk conservatively.
MAX_CHUNK=1900

while [ -n "$MSG" ]; do
  CHUNK="${MSG:0:$MAX_CHUNK}"
  MSG="${MSG:$MAX_CHUNK}"
  BODY="$(jq -n --arg t "$CHUNK" '{content: $t, allowed_mentions: {parse: ["users"]}}')"
  if [ "$DRY_RUN" = "1" ]; then
    echo "$BODY"
    continue
  fi
  RESP="$(curl -s --max-time 15 -X POST "$API/channels/$CHANNEL_ID/messages" \
    -H "Authorization: Bot $TOKEN" -H 'Content-Type: application/json' -d "$BODY")"
  if ! echo "$RESP" | jq -e '.id' >/dev/null 2>&1; then
    echo "notify: send failed: $RESP" >&2
    exit 1
  fi
done
